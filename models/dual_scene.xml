<mujoco model="scene">
  <option timestep="0.005"/>
  <include file="meshes/dual_mevion_mujoco.xml"/>

  <default>
    <joint armature="0.05" damping="0.1" limited="true" frictionloss="0.1"/>
    <general dyntype="filterexact" dynprm="0.01"/>
  </default>

  <visual>
    <headlight diffuse="0.6 0.6 0.6"  ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
        height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
        rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
        reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 0.0" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

  <actuator>
    <general name="RL_shoulder_yaw" joint="RL_shoulder_yaw" ctrllimited="true" ctrlrange="-60 60" biastype="none"/>
    <general name="RL_shoulder_pitch" joint="RL_shoulder_pitch" ctrllimited="true" ctrlrange="-60 60" biastype="none"/>
    <general name="RL_elbow_pitch" joint="RL_elbow_pitch" ctrllimited="true" ctrlrange="-60 60" biastype="none"/>
    <general name="RL_elbow_yaw" joint="RL_elbow_yaw" ctrllimited="true" ctrlrange="-17 17" biastype="none"/>
    <general name="RL_wrist_pitch" joint="RL_wrist_pitch" ctrllimited="true" ctrlrange="-17 17" biastype="none"/>
    <general name="RL_wrist_yaw" joint="RL_wrist_yaw" ctrllimited="true" ctrlrange="-17 17" biastype="none"/>
    <general name="RL_gripper_prismatic_left" joint="RL_gripper_prismatic_left" ctrllimited="true" ctrlrange="-12 12" biastype="none"/>
    <general name="RF_shoulder_yaw" joint="RF_shoulder_yaw" ctrllimited="true" ctrlrange="-60 60" biastype="none"/>
    <general name="RF_shoulder_pitch" joint="RF_shoulder_pitch" ctrllimited="true" ctrlrange="-60 60" biastype="none"/>
    <general name="RF_elbow_pitch" joint="RF_elbow_pitch" ctrllimited="true" ctrlrange="-60 60" biastype="none"/>
    <general name="RF_elbow_yaw" joint="RF_elbow_yaw" ctrllimited="true" ctrlrange="-17 17" biastype="none"/>
    <general name="RF_wrist_pitch" joint="RF_wrist_pitch" ctrllimited="true" ctrlrange="-17 17" biastype="none"/>
    <general name="RF_wrist_yaw" joint="RF_wrist_yaw" ctrllimited="true" ctrlrange="-17 17" biastype="none"/>
    <general name="RF_gripper_prismatic_left" joint="RF_gripper_prismatic_left" ctrllimited="true" ctrlrange="-12 12" biastype="none"/>
  </actuator>

  <!--
  <actuator>
    <position name="RL_shoulder_yaw" kp="50" kv="2" joint="RL_shoulder_yaw"/>
    <position name="RL_shoulder_pitch" kp="50" kv="2" joint="RL_shoulder_pitch"/>
    <position name="RL_elbow_pitch" kp="50" kv="2" joint="RL_elbow_pitch"/>
    <position name="RL_elbow_yaw" kp="20" kv="2" joint="RL_elbow_yaw"/>
    <position name="RL_wrist_pitch" kp="20" kv="2" joint="RL_wrist_pitch"/>
