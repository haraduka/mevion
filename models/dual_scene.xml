  </actuator>
  -->

  <equality>
    <joint joint1="RL_gripper_prismatic_left" joint2="RL_gripper_prismatic_right" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="RF_gripper_prismatic_left" joint2="RF_gripper_prismatic_right" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <keyframe>
    <key name="RESET"
      qpos="0.0 -0.91 2.69 0.0 0.63 1.57 0.0 0.0 0.0 -0.91 2.69 0.0 0.63 1.57 0.0 0.0"
      ctrl="0.0 -0.91 2.69 0.0 0.63 1.57 0.0 0.0 -0.91 2.69 0.0 0.63 1.57 0.0" />
  </keyframe>

</mujoco>
