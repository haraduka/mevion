    <position name="RL_gripper_prismatic_left" kp="20" kv="2" joint="RL_gripper_prismatic_left"/>
    <position name="RF_shoulder_yaw" kp="50" kv="2" joint="RF_shoulder_yaw"/>
    <position name="RF_shoulder_pitch" kp="50" kv="2" joint="RF_shoulder_pitch"/>
    <position name="RF_elbow_pitch" kp="50" kv="2" joint="RF_elbow_pitch"/>
    <position name="RF_elbow_yaw" kp="20" kv="2" joint="RF_elbow_yaw"/>
    <position name="RF_wrist_pitch" kp="20" kv="2" joint="RF_wrist_pitch"/>
    <position name="RF_wrist_yaw" kp="20" kv="2" joint="RF_wrist_yaw"/>
